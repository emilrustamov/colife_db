# After Bitrix app reinstall + report parity check:
# 1) replace root of prices.colifeb24apps.com with this public path
# 2) reload nginx
# 3) remove legacy cron: php /var/www/prices/sync.php
#
# Keep SSL certbot blocks from the existing site file.

server {
    listen 443 ssl http2;
    server_name prices.colifeb24apps.com;

    root /var/www/colife_db/public;
    index index.php;

    access_log /var/log/nginx/prices.access.log;
    error_log /var/log/nginx/prices.error.log;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
